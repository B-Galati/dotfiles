{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "MAX_CONSECUTIVE_AUTOCOMPACT_FAILURES": "3"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "WebFetch",
      "Bash(make quick-phpstan:*)",
      "Bash(bin/symfony php bin/phpunit:*)",
      "Bash(find:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git commit:*)",
      "Bash(git parents:*)",
      "Bash(glab:*)",
      "Bash(make test-cc:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Write(./.env.example)"
    ],
    "deny": [
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "ask": [],
    "defaultMode": "plan"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send --app-name \"Claude Code\" --icon claude -h \"string:sound-name:complete\" \"Done thinking\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-send --app-name \"Claude Code\" --icon claude -h \"string:sound-name:complete\" \"Permission request\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": false
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "tui": "fullscreen"
}
